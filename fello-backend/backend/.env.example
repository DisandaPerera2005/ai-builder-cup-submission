# Firebase Admin (falls back to Application Default Credentials on GCE if unset)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
GOOGLE_CLOUD_PROJECT=

# Cloud SQL / PostgreSQL (whatsapp_messages, documents)
DATABASE_URL=

# Baileys gateway (backend -> gateway calls)
BAILEYS_API_URL=
BAILEYS_API_SECRET=

# Gateway -> backend webhook auth (message-webhook.js)
GATEWAY_WEBHOOK_SECRET=

# Google OAuth client (Drive/Gmail/Forms integration token refresh)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# NVIDIA NIM (LLM classification calls in src/drive-sync.js)
NVIDIA_API_KEY=
NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b

PORT=8080

# Agent -> backend relay auth (agent-whatsapp-routes.js; separate trust boundary
# from BAILEYS_API_SECRET and GATEWAY_WEBHOOK_SECRET)
AGENT_BACKEND_SECRET=

# Vertex AI Agent Engine resource for WhatsApp AI replies (agent-client.js)
AGENT_ENGINE_RESOURCE_NAME=
