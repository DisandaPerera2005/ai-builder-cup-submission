rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /tenants/{tenantId}/orgs/{orgId}/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.token.tenantId == tenantId
        && orgId in request.auth.token.orgs;
      allow write: if request.auth != null
        && request.auth.token.tenantId == tenantId
        && orgId in request.auth.token.orgs
        && request.auth.token.orgs[orgId].access != 'readonly'
        && request.auth.token.orgs[orgId].access != 'event_only';
    }

    // Per-user files (profile avatar — app/profile/page.tsx). Readable by any
    // signed-in user (avatars are shown to teammates across orgs), writable
    // only by the owner.
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default (no catch-all open rule).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
